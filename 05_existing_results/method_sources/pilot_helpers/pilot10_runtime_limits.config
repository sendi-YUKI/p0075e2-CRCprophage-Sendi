// Execution limits only. Scientific thresholds, CPUs, RAM and command lines unchanged.
process {
    withName: VIRAL_FUNCTIONS { time = '20h' }
    withName: VIRAL_KOFAM { time = '20h' }
    withName: VIRAL_FUNCTION_SUMMARY { time = '4h' }
    withName: COHORT_INDEX { time = '8h' }
    withName: COHORT_MAPPABILITY { time = '12h' }
    withName: COHORT_MEASURE { time = '12h' }
    withName: COHORT_REPORT { time = '4h' }
}
