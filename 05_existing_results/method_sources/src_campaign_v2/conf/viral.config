// Load after nextflow.config: nextflow run main_viral.nf -c conf/viral.config ...
params {
    enable_viral_kofam = false
    kofam_db = null
    kofam_db_manifest_sha256 = null
    viral_evidence_tools = "" // opt-in only; no real runs in install/prepare phase
    research_catalog = null
    research_source_manifest = null
    assembly_manifest = null
    catalog_scope = null
    legacy_catalog = null
    legacy_source_manifest = null
    canonical_gene_tables = null
    viral_gene_container = null
    viral_ani_percent = 95
    viral_af_percent = 85
    functions_db = "${System.getenv('HOME')}/databases/core/functions"
}
process {
    errorStrategy = 'terminate'
    withName: VIRAL_GENOMAD {
        container = 'community.wave.seqera.io/library/genomad:1.12.0--27836e6e665e84b5@sha256:da41ec2aed8f7288501c19eed915632564e98b767cf639f03453e74ebe9a60b5'
        cpus = 6
        memory = '12 GB'
        ext.args = '--splits 8'
        ext.prefix = { meta.id }
        publishDir = [path:{ "${params.outdir}/assemblies/${meta.id}/geNomad" }, mode:'copy']
    }
    withName: VIRAL_CHECKV {
        container = 'quay.io/biocontainers/checkv:1.0.3--pyhdfd78af_0@sha256:e71b0ab781af9a1093fcf160beee587cc96aa50ff7c1a2b078166201fa390725'
        cpus = 6
        memory = '12 GB'
        ext.prefix = { meta.id }
        publishDir = [path:{ "${params.outdir}/assemblies/${meta.id}/CheckV" }, mode:'copy']
    }
    withName: VIRAL_BLAST {
        container = 'community.wave.seqera.io/library/blast:2.17.0--d4fb881691596759@sha256:7f0f18604de90429273e086528b050ad4db0e8bb2eff5a63576afc38e222d27b'
    }
    withName: VIRAL_GENES { container = params.viral_gene_container }
    withName: VIRAL_FUNCTIONS { container = 'sha256:5bcc494406a8137d2103870fa7d3e71e46ec357c3b9af6b2e6ff770090b603f4' }
}

// Inputs and model databases are mounted read-only in native Nextflow containers.
docker.writableInputMounts = false
