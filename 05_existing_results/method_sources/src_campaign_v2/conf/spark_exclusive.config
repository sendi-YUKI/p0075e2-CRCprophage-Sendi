// Explicitly selected by CRC_SPARK_RESOURCE_PROFILE=exclusive20, inside Slurm.
// The allocation is rechecked by spark_runtime; the existing lock/write guard remains active.
executor {
    cpus = 20
    memory = '108 GB'
    queueSize = 4
}
process {
    resourceLimits = [cpus:20, memory:108.GB]
    maxForks = 3
    withName: GENOMAD_ENDTOEND { cpus=6; memory='12 GB'; maxForks=3 }
    withName: CHECKV_ENDTOEND { cpus=6; memory='12 GB'; maxForks=3 }
    withName: CORE_FUNCTIONS { cpus=18; memory='64 GB'; maxForks=1 }
    withName: CORE_CHECKM2 { cpus=6; memory='30 GB'; maxForks=3 }
    withName: CORE_GENES { cpus=2; memory='4 GB'; maxForks=3 }
}

// analysis1 reads engineering: two QC readsets, one assembly at a time.
process {
    withName: READS_CLEAN { cpus=8; memory=24.GB; maxForks=2 }
    withName: READS_COLLECT { cpus=2; memory=8.GB }
    withName: READS_ASSEMBLE { cpus=params.assembly_threads; memory=((params.assembly_memory_gib as Integer) + 8).GB; maxForks=1 }
    withName: ASSEMBLY_COLLECT { cpus=2; memory=8.GB }
}

// Two engineering metagenomes; modest concurrent geNomad, one functions task.
process {
    withName: VIRAL_GENOMAD { cpus=8; memory=24.GB; maxForks=2 }
    withName: VIRAL_CHECKV { cpus=6; memory=16.GB; maxForks=2 }
    withName: VIRAL_FUNCTIONS { cpus=18; memory=64.GB; maxForks=1 }
}
