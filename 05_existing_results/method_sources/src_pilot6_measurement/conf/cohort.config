params {
    cohort_prepared = null
    cohort_mapping_container = null
    cohort_metaphlan_container = null
    cohort_enable_metaphlan = false
    cohort_metaphlan_disabled_reason = 'blocked_memory_requires_30GB_current_task_budget_12GB'
    cohort_metaphlan_db = null
    cohort_metaphlan_index = null
    cohort_metaphlan_database_manifest = null
    cohort_task_memory_budget_gb = 12
    cohort_metaphlan_required_memory_gb = 30
}
def cohortToolFile = new File(projectDir.toString(), 'assets/reads_tools.json')
if (cohortToolFile.exists()) {
    def cohortTools = new groovy.json.JsonSlurper().parse(cohortToolFile)
    params.cohort_mapping_container = cohortTools['reads-qc']?.container
    params.cohort_metaphlan_container = cohortTools['reads-metaphlan']?.container
}

// Keep automatically staged input subdirectories read-only as well as explicit binds.
docker.writableInputMounts = false
