// Explicitly selected by CRC_SPARK_RESOURCE_PROFILE=exclusive20, inside Slurm.
// The allocation is rechecked by spark_runtime; the existing lock/write guard remains active.
executor {
    cpus = 20
    memory = '108 GB'
    queueSize = 4
}
process {
    resourceLimits = [cpus:20, memory:108.GB]
    maxForks = 3
    withName: GENOMAD_ENDTOEND { cpus=6; memory='12 GB'; maxForks=3 }
    withName: CHECKV_ENDTOEND { cpus=6; memory='12 GB'; maxForks=3 }
    withName: CORE_FUNCTIONS { cpus=18; memory='64 GB'; maxForks=1 }
    withName: CORE_CHECKM2 { cpus=6; memory='30 GB'; maxForks=3 }
    withName: CORE_GENES { cpus=2; memory='4 GB'; maxForks=3 }
}

// analysis1 reads engineering: two QC readsets, one assembly at a time.
process {
    withName: READS_CLEAN { cpus=8; memory=24.GB; maxForks=2 }
    withName: READS_COLLECT { cpus=2; memory=8.GB }
    withName: READS_ASSEMBLE { cpus=params.assembly_threads; memory=((params.assembly_memory_gib as Integer) + 8).GB; maxForks=1 }
    withName: ASSEMBLY_COLLECT { cpus=2; memory=8.GB }
}

// Two engineering metagenomes; modest concurrent geNomad, one functions task.
process {
    withName: VIRAL_GENOMAD { cpus=8; memory=24.GB; maxForks=2 }
    withName: VIRAL_CHECKV { cpus=6; memory=16.GB; maxForks=2 }
    withName: VIRAL_FUNCTIONS { cpus=6; memory=64.GB; maxForks=1 }
}

// Imported six-donor assemblies require memory for source-slice verification.
process {
 withName: VIRAL_COLLECT { cpus=1; memory=16.GB; maxForks=1 }
 withName: VIRAL_CLUSTER { cpus=1; memory=16.GB; maxForks=1 }
}

// Six donors measured as original QC readsets; donor union is calculated afterwards.
params.cohort_metaphlan_disabled_reason = 'not_enabled_engineering_pilot_no_species_abundance_inference'
process {
 withName: COHORT_INDEX { cpus=12; memory=40.GB; maxForks=1 }
 withName: COHORT_MAPPABILITY { cpus=8; memory=24.GB; maxForks=1 }
 withName: COHORT_MEASURE { cpus=8; memory=36.GB; maxForks=2 }
 withName: COHORT_REPORT { cpus=1; memory=8.GB; maxForks=1 }
}

// pilot10 explicit measurement time limits; no science/CPU/RAM change.
process {
 withName: COHORT_INDEX { time='8h' }
 withName: COHORT_MAPPABILITY { time='12h' }
 withName: COHORT_MEASURE { time='12h' }
 withName: COHORT_REPORT { time='4h' }
}

// analysis1 four-core shared allocation. Keep biological parameters unchanged.
// Slurm grants 4 CPUs / 36 GiB; reserve 3 GiB for Nextflow and launch/preflight.
params.cohort_task_memory_budget_gb = 33
executor { cpus=4; memory='33 GB'; queueSize=1 }
process {
 resourceLimits=[cpus:4,memory:33.GB]
 maxForks=1
 withName: COHORT_INDEX { cpus=4; memory=33.GB; maxForks=1; time='16h' }
 withName: COHORT_MAPPABILITY { cpus=4; memory=24.GB; maxForks=1; time='24h' }
 withName: COHORT_MEASURE { cpus=4; memory=32.GB; maxForks=1; time='24h' }
 withName: COHORT_REPORT { cpus=1; memory=8.GB; maxForks=1; time='4h' }
}

// One-shot resource increase. Completed tasks retain their original script threads.
params.cohort_task_memory_budget_gb = 66
executor { cpus=12; memory='66 GB'; queueSize=1 }
process {
 resourceLimits=[cpus:12,memory:66.GB]
 maxForks=1
 withName: COHORT_INDEX { cpus=4; memory=66.GB; maxForks=1; time='24h' }
 withName: COHORT_MAPPABILITY { cpus=4; memory=48.GB; maxForks=1; time='24h' }
 withName: COHORT_MEASURE { cpus={ ["ERR688367", "ERR688403", "ERR688422", "ERR688463", "ERR688514", "ERR688514_orphan0", "ERR688514_orphan1", "ERR688550", "ERR688550_orphan0", "ERR688550_orphan1", "ERR688569", "ERR688569_orphan0", "ERR688569_orphan1", "ERR688610_orphan0"].contains(meta.id) ? 4 : 12 }; memory=64.GB; maxForks=1; time='24h' }
 withName: COHORT_REPORT { cpus=1; memory=8.GB; maxForks=1; time='4h' }
}
