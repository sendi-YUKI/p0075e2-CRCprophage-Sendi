process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
    time = '1h'
    errorStrategy = 'terminate'
    maxRetries = 0
    shell = ['/bin/bash','-euo','pipefail']
    withName: GENOMAD_ENDTOEND {
        cpus = 6
        memory = '12 GB'
        time = '8h'
        maxForks = 1
        ext.args = { "--splits ${params.genomad_splits}" }
        ext.prefix = { meta.id }
        publishDir = [path:{"${params.outdir}/samples/${meta.id}/raw/genomad"}, mode:'copy']
    }
    withName: CHECKV_ENDTOEND {
        cpus = 6
        memory = '12 GB'
        time = '8h'
        maxForks = 1
        ext.prefix = { meta.id }
        publishDir = [path:{"${params.outdir}/samples/${meta.id}/raw/checkv"}, mode:'copy']
    }
}
// Local executor schedules by both CPUs and memory. Heavy callers consume the
// complete budget so geNomad and CheckV cannot overlap and exceed it.
executor {
    cpus = 6
    memory = '12 GB'
    queueSize = 2
}
