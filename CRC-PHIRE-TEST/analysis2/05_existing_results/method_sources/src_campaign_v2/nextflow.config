manifest {
    name = 'crc-phage-pipeline'
    description = 'Development: DNA Illumina reads, bacterial prophages, viral discovery, frozen-catalog measurement and reviewed associations'
    version = '0.3.0-dev.2'
    nextflowVersion = '!25.10.4'
    mainScript = 'main.nf'
}
params {
    input = null
    outdir = 'results'
    genomad_db = null
    checkv_db = null
    genomad_splits = 8
}
workDir = "${System.getenv('HOME')}/scratch/crc-phage/work"
// Calling main.nf directly must use the same fixed containers as the launcher.
docker.enabled = true
docker.runOptions = '--platform linux/amd64 --user $(id -u):$(id -g)'
conda.enabled = false
includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'
profiles {
    spark_native { docker.enabled = false }
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64 --user $(id -u):$(id -g)'
    }
    // Fixture tests never claim caller accuracy. Real runs require Docker.
    test { params.input = "${projectDir}/tests/data/genomes.tsv" }
}
timeline { enabled=true; file="${params.outdir}/pipeline_info/timeline.html"; overwrite=true }
report { enabled=true; file="${params.outdir}/pipeline_info/report.html"; overwrite=true }
trace { enabled=true; file="${params.outdir}/pipeline_info/trace.tsv"; overwrite=true }
dag { enabled=true; file="${params.outdir}/pipeline_info/dag.html"; overwrite=true }
