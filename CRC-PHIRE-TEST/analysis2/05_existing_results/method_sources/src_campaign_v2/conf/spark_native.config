    withName: EMPTY_QUALITY { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: COLLECT_REPORT { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: GENOMAD_ENDTOEND { container = sparkContainers['core-genomad']; ext.spark_native_identity = sparkContainers['core-genomad']; beforeScript = sparkActivations['core-genomad'] }
    withName: CHECKV_ENDTOEND { container = sparkContainers['core-checkv']; ext.spark_native_identity = sparkContainers['core-checkv']; beforeScript = sparkActivations['core-checkv'] }
    withName: VIRAL_GENOMAD { container = sparkContainers['core-genomad']; ext.spark_native_identity = sparkContainers['core-genomad']; beforeScript = sparkActivations['core-genomad'] }
    withName: VIRAL_CHECKV { container = sparkContainers['core-checkv']; ext.spark_native_identity = sparkContainers['core-checkv']; beforeScript = sparkActivations['core-checkv'] }
    withName: READS_CLEAN { container = sparkContainers['reads-qc']; ext.spark_native_identity = sparkContainers['reads-qc']; beforeScript = sparkActivations['reads-qc']; maxForks=1 }
    withName: READS_COLLECT { container = sparkContainers['reads-qc']; ext.spark_native_identity = sparkContainers['reads-qc']; beforeScript = sparkActivations['reads-qc'] }
    withName: READS_ASSEMBLE { container = sparkContainers['reads-assembly']; ext.spark_native_identity = sparkContainers['reads-assembly']; beforeScript = sparkActivations['reads-assembly'] }
