    withName: CORE_FASTANI { container = sparkContainers['core-fastani']; ext.spark_native_identity = sparkContainers['core-fastani']; beforeScript = sparkActivations['core-fastani'] }
    withName: CORE_TAXONOMY_NORMALIZE { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: CORE_QC_COLLECT { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: CORE_BLAST { container = sparkContainers['core-blast']; ext.spark_native_identity = sparkContainers['core-blast']; beforeScript = sparkActivations['core-blast'] }
    withName: CORE_RESEARCH_CATALOG { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: CORE_LOCUS_EVIDENCE { container = sparkContainers['core-blast']; ext.spark_native_identity = sparkContainers['core-blast']; beforeScript = sparkActivations['core-blast'] }
