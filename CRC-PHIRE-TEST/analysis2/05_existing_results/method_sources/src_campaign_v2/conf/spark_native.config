// Load LAST, only through spark-run inside one CPU Slurm allocation.
// Native locked prefixes are not Docker/Apptainer containers.
def sparkDependenciesFile = new File("${projectDir}/assets/spark_dependencies.json")
def sparkDependencies = sparkDependenciesFile.exists() ? new groovy.json.JsonSlurper().parse(sparkDependenciesFile) : [environments:[:]]
def sparkIdentitiesFile = new File("${projectDir}/assets/spark_runtime_identities.json")
def sparkIdentities = sparkIdentitiesFile.exists() ? new groovy.json.JsonSlurper().parse(sparkIdentitiesFile) : [environments:[:]]
def sparkGuardFingerprint = java.security.MessageDigest.getInstance('SHA-256').digest(
    ['bin/spark_runtime.py','bin/spark_fs_guard.py','bin/spark-task-shell','conf/spark_native.config'].collect {
        new File("${projectDir}/${it}").text
    }.join('\n').getBytes('UTF-8')).encodeHex().toString()
// Read-only, stable scientific source/model/DB-manifest content; no large DB scan.
def sparkCacheProbe = new ProcessBuilder('/usr/bin/python3', "${projectDir}/bin/spark_cache_identity.py").start()
def sparkCacheText = sparkCacheProbe.inputStream.text
def sparkCacheError = sparkCacheProbe.errorStream.text
if (sparkCacheProbe.waitFor() != 0) throw new IllegalStateException("Native cache identity failed: ${sparkCacheError}")
def sparkCacheIdentity = new groovy.json.JsonSlurper().parseText(sparkCacheText)
def sparkContainers = sparkDependencies.environments.keySet().collectEntries { key ->
    def identity = java.security.MessageDigest.getInstance('SHA-256').digest(
        (sparkGuardFingerprint + sparkCacheIdentity.fingerprint + (sparkIdentities.environments[key]?.fingerprint ?: 'NOT_READY')).getBytes('UTF-8')).encodeHex().toString()
    [(key): "native-lock://${key}@sha256:${identity}".toString()]
}

def sparkActivations = sparkDependencies.environments.keySet().collectEntries { key ->
        [(key): """
        # native_runtime_lock=${sparkDependencies.environments[key]?.lock_sha256 ?: 'NOT_READY'}
        # native_runtime_identity=${sparkIdentities.environments[key]?.fingerprint ?: 'NOT_READY'}
        # native_guard_and_config=${sparkGuardFingerprint}
        activation="\$(/usr/bin/python3 '${projectDir}/bin/spark_runtime.py' shell '${key}')" || exit \$?
        eval "\$activation"
        """.toString()]
}

docker.enabled = false
singularity.enabled = false
apptainer.enabled = false
podman.enabled = false
conda.enabled = false
executor {
    name = 'local'
    cpus = 6
    memory = '46 GB' // reserve 2 GiB of the 48 GiB allocation for Nextflow
    queueSize = 1
}
params.cohort_task_memory_budget_gb = 46
params.cohort_metaphlan_disabled_reason = 'not_enabled_on_this_run'
process {
    executor = 'local'
    maxForks = 1
    resourceLimits = [cpus:6, memory:46.GB]
    beforeScript = 'echo "Missing explicit Spark native process mapping" >&2; exit 78'
    shell = ["${projectDir}/bin/spark-task-shell",'-euo','pipefail']
    // Exact names override the source module container directives. These
    // identities are recorded here AND referenced by each process script via ext;
    // disabled container engines do not hash the container directive on their own.
    withName: CORE_KOFAM_DB_VALIDATE { container = sparkContainers['kofam']; ext.spark_native_identity = sparkContainers['kofam']; beforeScript = sparkActivations['kofam'] }
    withName: VIRAL_KOFAM_DB_VALIDATE { container = sparkContainers['kofam']; ext.spark_native_identity = sparkContainers['kofam']; beforeScript = sparkActivations['kofam'] }
    withName: VIRAL_KOFAM { container = sparkContainers['kofam']; ext.spark_native_identity = sparkContainers['kofam']; beforeScript = sparkActivations['kofam'] }
    withName: CORE_WHOLE_GENOME_EVIDENCE { container = sparkContainers['core-blast']; ext.spark_native_identity = sparkContainers['core-blast']; beforeScript = sparkActivations['core-blast'] }
    withName: HOST_RECOMBINATION { container = sparkContainers['recombination']; ext.spark_native_identity = sparkContainers['recombination']; beforeScript = sparkActivations['recombination'] }
    withName: CORE_KOFAM { container = sparkContainers['kofam']; ext.spark_native_identity = sparkContainers['kofam']; beforeScript = sparkActivations['kofam'] }
    withName: CORE_KOFAM_SUMMARY { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: HOST_SOURCE_ASSOCIATION { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: HOST_CORE_GFF { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: HOST_CORE_PANAROO { container = sparkContainers['host-core']; ext.spark_native_identity = sparkContainers['host-core']; beforeScript = sparkActivations['host-core'] }
    withName: HOST_CORE_ALIGN { container = sparkContainers['host-tree']; ext.spark_native_identity = sparkContainers['host-tree']; beforeScript = sparkActivations['host-tree'] }
    withName: HOST_TREE_PRELIMINARY { container = sparkContainers['host-tree']; ext.spark_native_identity = sparkContainers['host-tree']; beforeScript = sparkActivations['host-tree'] }
    withName: HOST_MOBILE_MASK { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
