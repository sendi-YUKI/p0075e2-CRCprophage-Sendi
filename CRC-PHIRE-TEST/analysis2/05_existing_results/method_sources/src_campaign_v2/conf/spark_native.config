    withName: CORE_COMPARE_CALLERS { container = sparkContainers['core-callers']; ext.spark_native_identity = sparkContainers['core-callers']; beforeScript = sparkActivations['core-callers'] }
    withName: CORE_REPORT { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: VIRAL_PREPARE { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: VIRAL_COLLECT { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: RESEARCH_V1_BRIDGE { container = sparkContainers['core-blast']; ext.spark_native_identity = sparkContainers['core-blast']; beforeScript = sparkActivations['core-blast'] }
    withName: VIRAL_BLAST { container = sparkContainers['core-blast']; ext.spark_native_identity = sparkContainers['core-blast']; beforeScript = sparkActivations['core-blast'] }
    withName: VIRAL_CLUSTER { container = sparkContainers['python']; ext.spark_native_identity = sparkContainers['python']; beforeScript = sparkActivations['python'] }
    withName: VIRAL_BACPHLIP { container = sparkContainers['bacphlip']; ext.spark_native_identity = sparkContainers['bacphlip']; beforeScript = sparkActivations['bacphlip'] }
