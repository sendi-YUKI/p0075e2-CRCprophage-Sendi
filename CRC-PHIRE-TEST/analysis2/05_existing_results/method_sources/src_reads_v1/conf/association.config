params {
    association_long = null
    association_metadata = null
    association_spec = null
    association_container = null
}
def associationTools = new File("${projectDir}/assets/association_tools.json")
if (associationTools.exists()) {
    params.association_container = new groovy.json.JsonSlurper().parse(associationTools).container
}
process {
    withName: ASSOCIATION_MODELS {
        cpus = 4
        memory = '16 GB'
        maxForks = 4
        errorStrategy = 'terminate'
    }
}
// [2026-10-01] amd64 container path retired. It was left over from the user's
// earlier setup on a personal computer. The statistics layer now runs in the
// native Spark aarch64 environment envs/spark-association (pixi, linux-aarch64).
// Verified package versions match the retired docker image exactly:
//   R 4.4.3 (aarch64-conda-linux-gnu) / glmmTMB 1.1.14 / metafor 4.8.0 /
//   detectseparation 0.4.0 / TMB 1.9.19
// Also verified: detectseparation detects complete separation; metafor
// rma.uni(method="REML", test="knha") returns beta/CI/I2 correctly.
// /proc/sys/fs/binfmt_misc/ registers no qemu handler on this host, so amd64
// containers could never execute here; keeping the setting only creates the
// false impression that two execution paths exist.
// Original archived at results/aimbeta_revision_20261001/before/association.config
docker.enabled = false
executor.queueSize = 4
