// READS_B1_B2_BUILD: fixed local images plus real Pixi lock files.
def readsToolsFile = new File("${projectDir}/assets/reads_tools.json")
def readsTools = readsToolsFile.exists() ? new groovy.json.JsonSlurper().parse(readsToolsFile) : [:]
params {
    raw_reads_manifest = null
    clean_reads_manifest = null
    preprocessing_profile = "${projectDir}/assets/profiles/reads_preprocessing_dev_v1.json"
    database_manifest = "${projectDir}/assets/reads_databases.json"
    software_manifest = "${projectDir}/assets/reads_tools.json"
    assembly_threads = 6
    assembly_memory_gib = 10
    enable_phispy = false
    human_index = null
    virome_db = null
    bakta_db = null
    reads_qc_container = readsTools['reads-qc']?.container
    reads_assembly_container = readsTools['reads-assembly']?.container
    reads_bakta_container = readsTools['reads-bakta']?.container
}
process {
    withName: READS_CLEAN { container=params.reads_qc_container; cpus=3; memory=6.GB; maxForks=2; time=24.h }
    withName: READS_COLLECT { container=params.reads_qc_container; cpus=1; memory=2.GB }
    withName: READS_ASSEMBLE { container=params.reads_assembly_container; cpus=params.assembly_threads; memory=((params.assembly_memory_gib as Integer) + 8).GB; maxForks=1; time=48.h }
    withName: READS_ANNOTATE { container=params.reads_bakta_container; cpus=6; memory=12.GB; maxForks=1; time=24.h }
    withName: ASSEMBLY_COLLECT { cpus=1; memory=1.GB }
}
